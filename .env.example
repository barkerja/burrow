# Required
DATABASE_URL=ecto://postgres:postgres@localhost:5432/burrow_dev
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
BURROW_DOMAIN=localhost

# Server mode
BURROW_MODE=server
BURROW_PORT=4000

# Optional: LiveView
LIVE_VIEW_SALT=generate-with-mix-phx-gen-secret

# Optional: ACME / Let's Encrypt
# ACME_EMAIL=you@example.com
# ACME_DOMAINS=tunnel.example.com

# Optional: Cloudflare DNS-01
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Optional: GitHub OAuth for inspector
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: TCP tunnel port range
# TCP_PORT_RANGE=40000..40019
